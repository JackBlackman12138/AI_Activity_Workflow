{
  "id": "ProgressNodes",
  "name": "可追踪主进度节点",
  "fields": [
    {
      "key": "nodeId",
      "label": "节点ID",
      "type": "string",
      "required": true,
      "description": "主进度事件及领奖去重键"
    },
    {
      "key": "nodeType",
      "label": "节点类型",
      "type": "string",
      "required": true,
      "description": "POINT／QUALITY／COMPLETE"
    },
    {
      "key": "label",
      "label": "节点文案",
      "type": "string",
      "required": true,
      "description": "界面及事件日志共用"
    },
    {
      "key": "target",
      "label": "达成数值",
      "type": "number",
      "required": true,
      "description": "累计积分或不同ToyId数"
    },
    {
      "key": "collectionId",
      "label": "收藏组ID",
      "type": "string",
      "required": true,
      "description": "积分节点填ALL；品质节点与GachaToy关联"
    },
    {
      "key": "rewardIdsJson",
      "label": "奖励列表JSON",
      "type": "string",
      "required": true,
      "description": "JSON字符串：RewardCatalog奖励ID数组；同一节点可含多项奖励"
    },
    {
      "key": "claimMode",
      "label": "领取方式",
      "type": "string",
      "required": true,
      "description": "AUTO／MANUAL"
    },
    {
      "key": "sortOrder",
      "label": "展示及结算顺序",
      "type": "number",
      "required": true,
      "description": "积分节点按门槛升序"
    },
    {
      "key": "eventName",
      "label": "进度事件",
      "type": "string",
      "required": true,
      "description": "按平台契约上报的语义事件名"
    }
  ],
