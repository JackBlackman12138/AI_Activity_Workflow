# 仅填写本地或部署环境变量，不得提交真实密钥
NODE_ENV=development
WEB_PORT=4173
API_PORT=3001
DATA_FILE=D:\\AIActivityStudio\\data\\runtime.json
# 生产环境必须使用高熵随机值；用于 AES-256-GCM 派生密钥
ENCRYPTION_SECRET=replace_with_at_least_32_random_characters
DATABASE_URL=postgresql://activity:change_me@localhost:5432/activity_studio
WORKER_CONCURRENCY=2
